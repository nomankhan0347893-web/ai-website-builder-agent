# Google Gemini API Key (Required for Orchestrator, Design, and Reviewer agents)
GOOGLE_API_KEY=your_gemini_api_key_here

# Netlify Personal Access Token (Optional: for 1-click cloud deployment)
NETLIFY_AUTH_TOKEN=your_netlify_token_here

# Mistral API Key (Optional)
MISTRAL_API_KEY=your_mistral_key_here

# Vercel Token (Optional)
VERCEL_TOKEN=your_vercel_token_here
